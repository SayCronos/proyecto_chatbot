# Configuración de ejemplo para la aplicación
# Copia este archivo a .env y ajusta los valores según tus necesidades

# Configuración del servidor
APP_NAME="Starbucks Beverage Assistant"
APP_VERSION="2.0.0"
DEBUG=false

# Configuración de archivos
CSV_FILE_PATH="starbucks2.csv"
TEMPLATES_DIR="templates"

# Configuración del servidor web
HOST="127.0.0.1"
PORT=5000

# Configuración de estrategias por defecto
# Opciones para SEARCH_STRATEGY: exact, fuzzy, composite
DEFAULT_SEARCH_STRATEGY="composite"

# Opciones para PRICE_STRATEGY: basic, family, premium
DEFAULT_PRICE_STRATEGY="premium"

# Opciones para RESPONSE_STRATEGY: standard, detailed, compact
DEFAULT_RESPONSE_STRATEGY="standard"

# Opciones para SUGGESTION_STRATEGY: similarity, hybrid
DEFAULT_SUGGESTION_STRATEGY="hybrid"
