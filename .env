HOST=127.0.0.1
PUERTO=8000
DEBUG=true

# Configuración de la aplicación
NOMBRE_APP=Asistente de Bebidas Starbucks
VERSION_APP=2.0.0
RUTA_ARCHIVO_CSV=starbucks2.csv

# Estrategias por defecto
ESTRATEGIA_BUSQUEDA_DEFAULT=compuesta
ESTRATEGIA_PRECIO_DEFAULT=premium
ESTRATEGIA_RESPUESTA_DEFAULT=estandar
ESTRATEGIA_SUGERENCIA_DEFAULT=hibrida
